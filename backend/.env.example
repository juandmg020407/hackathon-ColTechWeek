# Operación local
DB_PATH=iomido.sqlite3
DEMO_MODE=true
DEMO_AUTO_IMPORT=false
EXTERNAL_SOURCES_ENABLED=false
EXTERNAL_TIMEOUT_SECONDS=5
EXTERNAL_MAX_RETRIES=2
MAX_IMPORT_BYTES=5000000
GRID_CELL_SIZE_M=10
RANDOM_SEED=42
LOG_LEVEL=INFO

# Seguridad. Vacío desactiva la exigencia de llave para escritura.
WRITE_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Explicador opcional. No existe proveedor habilitado por defecto.
AI_EXPLAINER_ENABLED=false
AI_TOTAL_BUDGET_USD=1.00
AI_MAX_INPUT_TOKENS=2000
AI_MAX_OUTPUT_TOKENS=500
AI_MODEL=disabled

# Precios configurables del proveedor elegido. Cero impide estimaciones ocultas.
AI_INPUT_PRICE_USD_PER_MILLION=0
AI_OUTPUT_PRICE_USD_PER_MILLION=0
