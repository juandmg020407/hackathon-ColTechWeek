# Operación local
# DB_PATH se omite: usa backend/iomido.sqlite3 localmente y /tmp en Vercel.
DEMO_MODE=true
# Siembra el Excel de demostración solo si el lote está vacío. En serverless la
# base vive en /tmp y se pierde en cada arranque en frío: sin esto el lote demo
# queda sin mediciones y la aplicación desplegada muestra el mock.
DEMO_AUTO_IMPORT=true
EXTERNAL_SOURCES_ENABLED=false
EXTERNAL_TIMEOUT_SECONDS=5
EXTERNAL_MAX_RETRIES=2
MAX_IMPORT_BYTES=5000000
GRID_CELL_SIZE_M=10
RANDOM_SEED=42
LOG_LEVEL=INFO

# Seguridad. Vacío desactiva la exigencia de llave para escritura.
WRITE_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Agente sobre evidencia. Es opt-in porque cada proceso serverless mantiene su
# propio contador. Antes de activarlo, configure tambien un limite de gasto en
# el workspace de Anthropic. Sin el, el backend conserva el modo determinista.
AI_EXPLAINER_ENABLED=false
AI_TOTAL_BUDGET_USD=2.00
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=800
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_SECONDS=10

# Precio estandar conservador de Claude Sonnet 5. La promocion temporal puede
# cobrar menos, pero estas cifras mantienen valido el tope cuando termine.
AI_INPUT_PRICE_USD_PER_MILLION=3.00
AI_OUTPUT_PRICE_USD_PER_MILLION=15.00

# Credencial de Anthropic. Va en el .env local, que .gitignore ya excluye.
ANTHROPIC_API_KEY=
