# Ninguna de estas claves es obligatoria para arrancar.
# El sistema degrada en vez de caerse: sin llave, la funcionalidad que la
# necesita se desactiva y el resto sigue andando.
#
# Open-Meteo y NASA POWER no piden llave, así que los riesgos climáticos y
# la climatología de 20 años funcionan sin configurar nada.

# Voz en español colombiano (500.000 caracteres gratis al mes)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_TTS_VOICE=es-CO-SalomeNeural

# Agente conversacional
ANTHROPIC_API_KEY=

# Focos de incendio activos — llave gratis en
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Persistencia
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gobernanza: sobre este gasto, la propuesta necesita visto bueno de un técnico
UMBRAL_REVISION_COP=1500000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
