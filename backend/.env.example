# Operación local
# DB_PATH se omite: usa backend/iomido.sqlite3 localmente y /tmp en Vercel.
DEMO_MODE=true
DEMO_AUTO_IMPORT=false
EXTERNAL_SOURCES_ENABLED=false
EXTERNAL_TIMEOUT_SECONDS=5
EXTERNAL_MAX_RETRIES=2
MAX_IMPORT_BYTES=5000000
GRID_CELL_SIZE_M=10
RANDOM_SEED=42
LOG_LEVEL=INFO

# Seguridad. Vacío desactiva la exigencia de llave para escritura.
WRITE_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Agente sobre evidencia. Si falta la credencial, el backend conserva el modo
# determinista y sigue arrancando. El presupuesto es acumulado por proceso.
AI_EXPLAINER_ENABLED=true
AI_TOTAL_BUDGET_USD=2.00
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=800
AI_MODEL=claude-sonnet-5
AI_TIMEOUT_SECONDS=10

# Precio estandar conservador de Claude Sonnet 5. La promocion temporal puede
# cobrar menos, pero estas cifras mantienen valido el tope cuando termine.
AI_INPUT_PRICE_USD_PER_MILLION=3.00
AI_OUTPUT_PRICE_USD_PER_MILLION=15.00

# Credencial de Anthropic. Va en el .env local, que .gitignore ya excluye.
ANTHROPIC_API_KEY=
